# Documentation placeholder only. Supply keys through your launcher's secret environment.
# The server adds no environment-file loader. Disable Bun's automatic loading:
# bun --no-env-file dist/cli.js
# Put --no-env-file before the entrypoint; do not pass an explicit --env-file.
# A key alone permits reads, with submissions disabled. Writes also require
# explicit --submission-policy/--submission-state paths and operator-chosen
# finite caps. No active policy, path or caps are selected by this file.
SPEEDYINDEX_API_KEY=replace-with-your-api-key
